<script setup>
    import { {{ lower .StructName }}Columns } from './{{ toPascal .StructName }}Columns.js'

    const props = defineProps({
        item: { type: Object, required: true },
    })
    const emit = defineEmits(['action'])
</script>

<template>
	<div class="data-card">
		<div v-for="col in {{ lower .StructName }}Columns" :key="col.key" class="card-row">
			<span class="card-label">{{ "{{" }} t(col.titleKey) {{ "}}" }}</span>
			<span class="card-value">{{ "{{" }} item[col.key] {{ "}}" }}</span>
		</div>
		<div class="card-actions">
			<slot name="actions" :item="item">
				<button @click="emit('action', { type: 'edit', item })">{{ "{{" }} t('{{$.Entity}}.edit') {{ "}}" }}</button>
				<button @click="emit('action', { type: 'delete', item })">{{ "{{" }} t('{{$.Entity}}.delete') {{ "}}" }}</button>
			</slot>
		</div>
	</div>
</template>
