<script setup>
    import {{{ lower .StructName }}Columns} from './{{ toPascal .StructName }}Columns.js'

    const props = defineProps({
        item: {type: Object, required: true},
    })
    const emit = defineEmits(['action'])
</script>

<template>
	<view class="data-card">
		<view v-for="col in {{ lower .StructName }}Columns" :key="col.key" class="card-row">
			<text class="card-label">{{ "{{" }} t(col.titleKey) {{ "}}" }}</text>
			<text class="card-value">{{ "{{" }} item[col.key] {{ "}}" }}</text>
		</view>
		<view class="card-actions">
			<slot name="actions" :item="item">
				<button size="mini" @click="emit('action', { type: 'edit', item })">{{ "{{" }} t('{{$.Entity}}
					.edit') {{ "}}" }}</button>
				<button size="mini" @click="emit('action', { type: 'delete', item })">{{ "{{" }} t('{{$.Entity}}
					.delete') {{ "}}" }}</button>
			</slot>
		</view>
	</view>
</template>
