<script setup>
    /**
     * @typedef {import('../shared/{{ lower .StructName }}.types.js').{{.StructName}}} {{.StructName}}
     */
            {{ if .SearchFormComp }}
            {{ end }}
    const props = defineProps({
            data: {type: Array, default: () => []},
            total: {type: Number, default: 0},
            page: {type: Number, default: 1},
            pageSize: {type: Number, default: 20},
            loading: {type: Boolean, default: false},
        })
    const emit = defineEmits(['search', 'reset', 'page-change', 'edit', 'delete'])

    function onAction(payload) {
        emit(payload.type, payload.row)
    }
    {{ if .SearchFormComp }}    function onSearch(q) {
        emit('search', q)
    }

    function onReset() {
        emit('reset')
    }
    {{ end }}
</script>

<template>
	<view class="list-view">
        {{ if .SearchFormComp }}
			<SearchFormComp @search="onSearch" @reset="onReset"/>
        {{ else }}
			<slot name="search"/>
        {{ end }}
		<view class="card-list">
			<CardComp v-for="item in data" :key="item.{{ toPkName . }}" :item="item">
				<template #actions="{ item }">
					<ActionsComp :row="item" @edit="(r) => emit('edit', r)" @delete="(r) => emit('delete', r)"/>
				</template>
			</CardComp>
		</view>
		<view class="pagination">
			<button size="mini" :disabled="page <= 1" @click="emit('page-change', page - 1)">{{ "{{" }} t('{{$.Entity}}
				.prev') {{ "}}" }}</button>
			<text>{{ "{{" }} page {{ "}}" }} / {{ "{{" }} Math.ceil(total / pageSize) {{ "}}" }}</text>
			<button size="mini" @click="emit('page-change', page + 1)">{{ "{{" }} t('{{$.Entity}}
				.next') {{ "}}" }}</button>
		</view>
	</view>
</template>
